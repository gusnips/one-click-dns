{
  "name": "@gusnips/one-click-dns",
  "version": "0.1.7",
  "packageManager": "bun@1.4.4",
  "description": "Put DNS records in a customer's zone: find their DNS host, send them to a signed Domain Connect link, write with an API token, or show the steps for that host",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "require": {
        "types": "./dist/server/index.d.cts",
        "default": "./dist/server/index.cjs"
      }
    },
    "./writers": {
      "import": {
        "types": "./dist/writers/index.d.ts",
        "default": "./dist/writers/index.js"
      },
      "require": {
        "types": "./dist/writers/index.d.cts",
        "default": "./dist/writers/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src scripts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test",
    "live": "bun scripts/live-check.ts",
    "prepublishOnly": "bun run lint && bun run typecheck && bun run build"
  },
  "keywords": [
    "dns",
    "domain-connect",
    "custom-domain",
    "cloudflare",
    "godaddy",
    "name-com",
    "registro-br",
    "typescript"
  ],
  "author": "Gustavo Salomé (gusnips)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gusnips/one-click-dns.git"
  },
  "bugs": {
    "url": "https://github.com/gusnips/one-click-dns/issues"
  },
  "homepage": "https://github.com/gusnips/one-click-dns#readme",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@gusnips/server": ">=0.14.3"
  },
  "devDependencies": {
    "@gusnips/oxlint": "^0.2.0",
    "@gusnips/server": "^0.15.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.5",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "tsdown": "0.23.7",
    "typescript": "^7.0.2"
  }
}
